<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF 컨트롤 — Windows 전용. AnyCPU (네이티브 OpenCV 런타임은 소비자가 플랫폼에 맞게 선택) -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CvInspect.Wpf</PackageId>
    <!-- 버전·공통 메타데이터는 루트 Directory.Build.props (락스텝) -->
    <Description>WPF display and shape-editing controls for the CvInspect machine-vision toolkit — Mat image display with zoom/pan/pixel probe, renderer-neutral overlay drawing, and draggable teaching shapes that write back to tool option POCOs. Based on OpenCvSharp; the native OpenCV runtime is chosen by the consumer (e.g. OpenCvSharp4.runtime.win).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>wpf;opencvsharp;machine-vision;inspection;display;overlay;roi;teaching</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- 코어(알고리즘·오버레이·번역 seam) — 같은 솔루션이라 프로젝트 참조. pack 시 CvInspect 패키지
         의존성으로 변환된다. OpenCvSharp4 관리 어셈블리는 이 참조로 전이되고,
         네이티브 런타임(OpenCvSharp4.runtime.*)은 여기서 정하지 않는다 — 소비자(앱) 선택. -->
    <ProjectReference Include="..\CvInspect\CvInspect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 코어 Display\ 의 UI 중립 계층(아직 internal)을 소스로 들인다. 코어 어셈블리의 internal 을 IVT 로 빌려 쓰면
         소비자가 코어만 올린 조합에서 시그니처가 어긋나 실행 중에 MissingMethodException 이 난다 — 소스 링크는 그 의존을 만들지 않는다.
         공개로 열면 이 링크를 걷고 코어의 public 을 쓴다. -->
    <Compile Include="..\CvInspect\Display\*.cs" Link="Display\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 회귀가 표면 조작(누름·끌기·놓기)을 좌표로 부른다 — 마우스 이벤트 인자는 실제 장치 위치를 읽어 합성 이벤트로는 자리를 못 준다. -->
    <InternalsVisibleTo Include="CvInspect.Wpf.Tests" />
  </ItemGroup>

</Project>
