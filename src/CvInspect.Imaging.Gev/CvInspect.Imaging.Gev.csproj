<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CvInspect.Imaging.Gev</PackageId>
    <!-- 버전·공통 메타데이터는 루트 Directory.Build.props (락스텝) -->
    <Description>GigE camera acquisition for the CvInspect toolkit - an ICam backend that speaks the protocol directly, with no vendor SDK and no proprietary DLLs. Serial-number binding with actionable discovery diagnostics, user-set load, exposure control across SFNC generations, and PFNC pixel conversion including Bayer demosaic with phase diagnostics. Run against real hardware with no vendor SDK installed - an eight-hour two-camera monochrome run without a lost packet, and a colour pair acquiring on an inspection line. Only a few models have been exercised, so treat other cameras as unproven.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>gige;genicam;camera;acquisition;machine-vision;opencvsharp;vendor-free</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 진단 계측기는 공개 표면이 아니지만 회귀로 고정한다 — 확인 못 한 진단을 넣지 않기 위해서다. -->
    <InternalsVisibleTo Include="CvInspect.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CvInspect.Imaging\CvInspect.Imaging.csproj" />
    <!-- GigE 취득 백엔드 - 공개 피드에서 받는다(nuget.org).
         OpenCV 무의존이라 이 참조가 네이티브를 끌어오지 않는다. -->
    <PackageReference Include="GevSharp" Version="0.2.1" />
  </ItemGroup>

</Project>
