<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 취득 계약 + 온순한 소스(가상/비디오)만 — GigE 등 무거운 백엔드는 별도 패키지로 격리한다 -->
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CvInspect.Imaging</PackageId>
    <!-- 버전·공통 메타데이터는 루트 Directory.Build.props (락스텝) -->
    <Description>Camera acquisition contract and tame frame sources for the CvInspect machine-vision toolkit — an ICam abstraction with factory registration, a virtual camera (test pattern / image-folder replay), and a VideoCapture-backed source (webcam, video file, RTSP). Frames are OpenCvSharp Mat; heavy vendor/GigE backends plug in as separate adapter packages.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>opencvsharp;machine-vision;camera;acquisition;videocapture;virtual-camera</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- 코어 — Mat(OpenCvSharp4 전이)과 CvLog 로깅 seam. 네이티브 런타임은 소비자 선택. -->
    <ProjectReference Include="..\CvInspect\CvInspect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 매칭 규칙과 Linux sysfs 해석은 순수 논리라 회귀가 직접 부른다. -->
    <InternalsVisibleTo Include="CvInspect.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
