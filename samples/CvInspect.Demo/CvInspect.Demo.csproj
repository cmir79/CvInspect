<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 툴킷을 한 화면에 모은 예제 — 표시(CvDispCtrl) + 도형 편집 + 파라미터 편집기(CvPropEditCtrl) + 취득(VirtualCam)
         + 검사(라인/원 파인더)가 어떻게 이어지는지 보여 준다. WPF 라 Windows 전용. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CvInspect.Demo</RootNamespace>
    <AssemblyName>CvInspect.Demo</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CvInspect.Wpf\CvInspect.Wpf.csproj" />
    <ProjectReference Include="..\..\src\CvInspect.Imaging\CvInspect.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 네이티브 런타임은 소비자가 고른다는 계약 — 앱이 소비자다. -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <!-- 화면 VM 용 MVVM 툴킷 — 라이브러리 쪽은 이것을 참조하지 않는다(예제의 선택일 뿐). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- 루트 README 의 "LGPL 코덱 빼기" 레시피 그대로. 이 예제는 이미지를 ImDecode 로만 읽고 동영상(videoio)은 쓰지
       않으므로 27MB 짜리 opencv_videoio_ffmpeg 를 게시물에서 뺀다. 게시 목록과 빌드 출력이 서로 다른 항목으로
       흐르므로 타깃이 둘이고, 게시 쪽은 단일파일 번들 목록이 확정되는 ComputeResolvedFilesToPublishList 뒤여야 한다. -->
  <Target Name="DropVideoCodecFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
    </ItemGroup>
  </Target>
  <Target Name="DropVideoCodecFromBuild" AfterTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
    </ItemGroup>
  </Target>

</Project>
