<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- USB 웹캠 식별 실기 검증 도구 — 열거 결과, 백엔드별 인덱스 촬영, VID/PID 로 다시 열어 같은 카메라인지 대조.
         카메라가 둘 이상 꽂힌 PC 에서 돌리고 산출 폴더째 회수한다. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>usbcamprobe</AssemblyName>
    <RootNamespace>CvInspect.UsbCamProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CvInspect.Imaging\CvInspect.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 프레임을 파일로 남기려면 네이티브 런타임이 필요하다 — 소비자가 고르는 것이 규약이라 여기서 고른다. -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

</Project>
