<Project>

  <PropertyGroup>
    <!-- 락스텝 버전 — 전 패키지가 이 한 값을 공유한다. 이 값은 "다음 릴리스의 번호" 다: main 은 이 번호를 달고 커밋을
         쌓고, 판은 릴리스(v* 태그)마다 한 번 정한다 — 쌓인 것에 API 추가가 있으면 minor, 문서·수정뿐이면 patch.
         커밋마다 올리지 않는다. 불변인 것 하나: 이미 nuget.org 에 올린 번호는 다시 쓰지 않는다(지울 수도 덮어쓸 수도 없다). -->
    <Version>0.19.0</Version>

    <Authors>kintaein</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cmir79/CvInspect</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cmir79/CvInspect</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
